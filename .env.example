# Public DNS name. Point an A/AAAA record to this server before starting Caddy.
PORTAL_DOMAIN=portal.cohvera.be

POSTGRES_USER=cohvera
POSTGRES_PASSWORD=change-this-to-a-long-random-password
POSTGRES_DB=cohvera

# Sprint 1 runs with a local development identity. Entra is wired in a later auth hardening step.
AUTH_MODE=development

# Required for plugin install/enable/disable/uninstall actions in the MVP admin UI.
# Generate a long random value, e.g. `openssl rand -hex 32`.
PLUGIN_ADMIN_TOKEN=change-this-to-a-long-random-admin-token

AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
