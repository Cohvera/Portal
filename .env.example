# Public DNS name. Point an A/AAAA record to this server before starting Caddy.
PORTAL_DOMAIN=portal.cohvera.be

POSTGRES_USER=cohvera
POSTGRES_PASSWORD=change-this-to-a-long-random-password
POSTGRES_DB=cohvera

# Use entra for Microsoft sign-in. Development must be explicitly chosen for local testing.
AUTH_MODE=entra
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=https://portal.cohvera.be/auth/callback
# Roles are refreshed by signing in again when the server session expires (5-60 minutes).
ENTRA_SESSION_MINUTES=15

# Local web dev server -> API (optional; Docker/Caddy handles production routing).
# API_URL=http://127.0.0.1:4000
# WEB_URL=http://localhost:3000

# Empty: built-in SG-QHOME-All, SG-TOMME-All, SG-WARCO-All -> employee.
# Requires exact group names in the verified Entra ID-token groups claim.
# Optional JSON override; [] explicitly disables all company mappings.
ENTRA_GROUP_MAPPINGS=

# Optional app-only project API: API registration client ID (v2 audience).
ENTRA_API_AUDIENCE=
# Map authorized Warehouse application client IDs to company codes. Empty denies all.
# ENTRA_SERVICE_CLIENTS='{"warehouse-client-uuid":["TOMME"]}'
ENTRA_SERVICE_CLIENTS=

# Alternative to Entra app consent: dedicated read-only Warehouse key.
# Generate 32 random bytes as base64url. Empty disables this method.
WAREHOUSE_PROJECTS_API_KEY=
WAREHOUSE_PROJECTS_COMPANIES=TOMME
