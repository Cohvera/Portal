{
  "name": "@cohvera/api",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "test:inspections": "tsx --test src/inspections/*.test.ts",
    "test:auth": "tsx --test src/auth/*.test.ts",
    "test:qbox": "tsx --test src/integrations/qbox.test.ts"
  },
  "dependencies": {
    "@cohvera/auth": "workspace:*",
    "@cohvera/contracts": "workspace:*",
    "@cohvera/database": "workspace:*",
    "@cohvera/plugin-sdk": "workspace:*",
    "@cohvera/services": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "jose": "^6",
    "openid-client": "^6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^5",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
