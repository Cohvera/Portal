generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PluginState {
  ACTIVE
  DISABLED
  MAINTENANCE
  UNHEALTHY
  DEPRECATED
}

enum PluginRuntime {
  BUILTIN
  EXTERNAL
}

model Company {
  id            String              @id @default(cuid())
  code          String              @unique
  name          String
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  projects      Project[]
  memberships   CompanyMembership[]
  pluginLinks   CompanyPlugin[]
  notifications Notification[]
  auditLogs     AuditLog[]
  inspections   Inspection[]
}

model User {
  id            String              @id @default(cuid())
  entraObjectId String?
  entraTenantId String?
  email         String              @unique
  displayName   String
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  memberships   CompanyMembership[]
  notifications Notification[]
  auditLogs     AuditLog[]
  sessions      PortalSession[]
  @@unique([entraTenantId, entraObjectId])
}

model Role {
  id          String              @id @default(cuid())
  key         String              @unique
  name        String
  description String?
  memberships CompanyMembership[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model CompanyMembership {
  userId    String
  companyId String
  roleId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      Role    @relation(fields: [roleId], references: [id])

  @@id([userId, companyId])
  @@index([companyId])
}

model Plugin {
  id            String          @id
  name          String
  description   String?
  version       String
  state         PluginState     @default(ACTIVE)
  apiVersion    String
  runtime       PluginRuntime   @default(BUILTIN)
  route         String?
  entrypointUrl String?
  manifestUrl   String?
  sourceUrl     String?
  installedAt   DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  companies     CompanyPlugin[]
}

model CompanyPlugin {
  companyId String
  pluginId  String
  enabled   Boolean @default(true)
  config    Json?
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plugin    Plugin  @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@id([companyId, pluginId])
}

model Notification {
  id        String   @id @default(cuid())
  companyId String
  userId    String?
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([userId, readAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  userId     String?
  pluginId   String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([pluginId, createdAt])
}

model QboxImport {
  companyCode      String @id
  snapshotId       String
  digest           String
  sourceObservedAt DateTime
  receivedAt       DateTime @default(now())
  projectCount     Int
}

model Project {
  id          String @id @default(cuid())
  companyId   String
  name        String
  customer    String
  owner       String
  status      String @default("Actief")
  statusColor String @default("#2563eb")
  dueDate     DateTime? @db.Date
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  externalSource String?
  externalId String?
  sourceDescription String?
  sourcePlannedAt DateTime? @db.Date
  sourceSeenAt DateTime?
  @@unique([companyId, externalSource, externalId])
  tasks       ProjectTask[]
  @@index([companyId])
}

model ProjectTask {
  id          String @id @default(cuid())
  projectId   String
  title       String
  description String @default("")
  assignee    String @default("")
  priority    String @default("NORMAL")
  status      String @default("TODO")
  dueDate     DateTime? @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId, status])
}

model ToolCatalog {
  id           String   @id
  kind         String
  name         String   @default("")
  description  String   @default("")
  href         String   @default("")
  companyCodes String[]
  updatedAt    DateTime @updatedAt
}

model Inspection {
  id String @id @default(cuid())
  companyId String
  version Int @default(1)
  data Json
  previousId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documents InspectionDocument[]
  events InspectionEvent[]
  @@index([companyId, updatedAt])
}

model InspectionDocument {
  id String @id @default(cuid())
  inspectionId String
  name String
  category String
  mime String
  size Int
  content Bytes
  createdAt DateTime @default(now())
  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  @@index([inspectionId])
}

model InspectionEvent {
  id String @id @default(cuid())
  inspectionId String
  actor String
  action String
  detail String
  createdAt DateTime @default(now())
  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  @@index([inspectionId, createdAt])
}

model PortalSession {
  tokenHash String @id
  userId String
  roles String[]
  tenantId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}

model EntraLoginAttempt {
  tokenHash String @id
  state String
  nonce String
  verifier String
  expiresAt DateTime
  @@index([expiresAt])
}
